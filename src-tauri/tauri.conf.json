{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmailFileViewer",
  "version": "0.1.0",
  "identifier": "com.github.realzony.emailfileviewer",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "node scripts/build-sidecar.mjs && npm --prefix ui run dev",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "node scripts/build-sidecar.mjs && npm --prefix ui run build",
      "cwd": ".."
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/efv-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
