<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- 允许下面的传递依赖版本覆盖 MimeKit / MsgReader 带进来的旧版本 -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- 解析核心 -->
    <PackageVersion Include="MimeKit" Version="4.18.1" />
    <PackageVersion Include="MsgReader" Version="6.2.0" />

    <!-- 下面三个是 MsgReader 6.2.0 的传递依赖，Core 直接用到它们，所以显式写出版本（与 MsgReader 带进来的版本一致） -->
    <!-- RtfPipe：把纯 RTF 正文转成 HTML；UTF.Unknown：邮件没声明字符集时识别编码；OpenMcdf：测试里构造非邮件的 OLE 文件 -->
    <PackageVersion Include="RtfPipe" Version="2.0.7677.4303" />
    <PackageVersion Include="UTF.Unknown" Version="2.7.0" />
    <PackageVersion Include="OpenMcdf" Version="3.3.0" />

    <!-- MimeKit 4.18.1 和 MsgReader 6.2.0 都依赖 10.0.0 / 10.0.12，该版本有已公开的拒绝服务漏洞（NU1902 / NU1903），10.0.13 起修复 -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />

    <!-- 测试 -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
