<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- 允许下面的传递依赖版本覆盖 MimeKit / MsgReader 带进来的旧版本 -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- 解析核心 -->
    <PackageVersion Include="MimeKit" Version="4.18.1" />
    <PackageVersion Include="MsgReader" Version="6.2.0" />

    <!-- MimeKit 4.18.1 和 MsgReader 6.2.0 都依赖 10.0.0 / 10.0.12，该版本有已公开的拒绝服务漏洞（NU1902 / NU1903），10.0.13 起修复 -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />

    <!-- 测试 -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
